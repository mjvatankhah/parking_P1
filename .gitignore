# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
/:memory:.ses

# Virtual environments
.venv
.uv-model-cache/

# Metadata carried over by Windows/macOS file copies
*:Zone.Identifier*
Thumbs.db
desktop.ini
.DS_Store
# Images
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# Videos
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.ts

# Archives
*.zip
*.rar
*.7z

# Offline UI textures must ship with the desktop application.
!src/plakino_ui/assets/icons/lucide/*.png
!src/plakino_ui/assets/icons/google/*.png

# Local passage diagnostic images and recognition metadata
/reports/crop_diagnostics/
/reports/diagnostic_documents/
/.local/

# Runtime passage diagnostics (independent of development reports)
/report_traffic/

/logs/
